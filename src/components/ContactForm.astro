---
import servicesData from '../data/services.json';
type Service = { title: string };
const services = servicesData as Service[];
---

<form
  name="contact"
  method="POST"
  action="/gracias"
  data-netlify="true"
  netlify-honeypot="bot-field"
  class="surface-card space-y-5 rounded-[1.5rem] p-5 sm:rounded-[2rem] sm:p-8 lg:p-10"
>
  <!-- Netlify requiere este input para detectar el form -->
  <input type="hidden" name="form-name" value="contact" />

  <!-- Honeypot anti-bot -->
  <p class="hidden">
    <label>No completar: <input name="bot-field" /></label>
  </p>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
    <label class="block">
      <span class="text-xs uppercase tracking-[0.2em] text-ink-700/70 font-semibold">Nombre*</span>
      <input type="text" name="name" required maxlength="120"
             class="mt-2 min-h-[52px] w-full rounded-xl border border-ink-900/10 bg-[#f7f4ed] px-4 py-3 text-ink-900 outline-none transition focus:border-brand-500 focus:bg-white focus:ring-2 focus:ring-brand-200" />
    </label>
    <label class="block">
      <span class="text-xs uppercase tracking-[0.2em] text-ink-700/70 font-semibold">Teléfono</span>
      <input type="tel" name="phone" maxlength="40"
             class="mt-2 min-h-[52px] w-full rounded-xl border border-ink-900/10 bg-[#f7f4ed] px-4 py-3 text-ink-900 outline-none transition focus:border-brand-500 focus:bg-white focus:ring-2 focus:ring-brand-200" />
    </label>
  </div>

  <label class="block">
    <span class="text-xs uppercase tracking-[0.2em] text-ink-700/70 font-semibold">Email*</span>
    <input type="email" name="email" required maxlength="200"
           class="mt-2 min-h-[52px] w-full rounded-xl border border-ink-900/10 bg-[#f7f4ed] px-4 py-3 text-ink-900 outline-none transition focus:border-brand-500 focus:bg-white focus:ring-2 focus:ring-brand-200" />
  </label>

  <label class="block">
    <span class="text-xs uppercase tracking-[0.2em] text-ink-700/70 font-semibold">Servicio de interés</span>
    <select name="service"
            class="mt-2 min-h-[52px] w-full rounded-xl border border-ink-900/10 bg-[#f7f4ed] px-4 py-3 text-ink-900 outline-none transition focus:border-brand-500 focus:bg-white focus:ring-2 focus:ring-brand-200">
      <option value="">Selecciona uno (opcional)</option>
      {services.map(s => <option value={s.title}>{s.title}</option>)}
    </select>
  </label>

  <label class="block">
    <span class="text-xs uppercase tracking-[0.2em] text-ink-700/70 font-semibold">Cuéntanos tu proyecto*</span>
    <textarea name="message" required minlength="10" maxlength="2000" rows="5"
              class="mt-2 w-full resize-y rounded-xl border border-ink-900/10 bg-[#f7f4ed] px-4 py-3 text-ink-900 outline-none transition focus:border-brand-500 focus:bg-white focus:ring-2 focus:ring-brand-200"
              placeholder="Ubicación, metros cuadrados, tiempo estimado, etc."></textarea>
  </label>

  <button type="submit" class="btn-primary w-full sm:w-auto">
    Enviar mensaje
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
  </button>

  <p class="text-xs text-ink-700/50">
    * campos obligatorios. Solo usamos tu información para responder tu consulta.
  </p>
</form>
