---
type Project = {
  id: string;
  title: string;
  year: number;
  location: string;
  image: string;
  description: string;
};
type Props = { projects: Project[] };
const { projects } = Astro.props;
---

<div class="swiper projectsSwiper" data-aos="fade-up">
  <div class="swiper-wrapper">
    {projects.map(p => (
      <div class="swiper-slide px-4">
        <div class="relative group rounded-3xl overflow-hidden aspect-[16/10] shadow-2xl">
          <img src={p.image} alt={p.title} loading="lazy"
               class="w-full h-full object-cover transition duration-[1500ms] group-hover:scale-110" />
          <div class="absolute inset-0 bg-gradient-to-t from-ink-900 via-ink-900/40 to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 p-8 text-white">
            <div class="text-xs uppercase tracking-[0.3em] text-brand-400 mb-2">
              {p.year} · {p.location}
            </div>
            <h3 class="font-display font-bold text-3xl md:text-4xl">{p.title}</h3>
            <p class="mt-3 max-w-xl text-white/80 text-sm md:text-base leading-relaxed">
              {p.description}
            </p>
          </div>
        </div>
      </div>
    ))}
  </div>

  <div class="swiper-pagination !relative !bottom-0 mt-10"></div>
  <div class="hidden md:block">
    <div class="swiper-button-prev !left-2"></div>
    <div class="swiper-button-next !right-2"></div>
  </div>
</div>

<script>
  // Hidrata el carousel con los proyectos destacados desde Supabase.
  // Si todo falla, queda el SSR fallback del JSON.
  import { getProjects } from '../lib/supabase';

  function escapeAttr(s: string): string {
    return s.replace(/&/g, '&amp;').replace(/"/g, '&quot;');
  }
  function escapeHtml(s: string): string {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;').replace(/'/g, '&#039;');
  }

  (async () => {
    try {
      const all = await getProjects();
      const featured = all.filter(p => p.featured);
      if (!featured.length) return; // mantenemos fallback

      const wrapper = document.querySelector('.projectsSwiper .swiper-wrapper');
      if (!wrapper) return;

      wrapper.innerHTML = featured.map(p => `
        <div class="swiper-slide px-4">
          <div class="relative group rounded-3xl overflow-hidden aspect-[16/10] shadow-2xl">
            <img src="${escapeAttr(p.image)}" alt="${escapeAttr(p.title)}" loading="lazy"
                 class="w-full h-full object-cover transition duration-[1500ms] group-hover:scale-110" />
            <div class="absolute inset-0 bg-gradient-to-t from-ink-900 via-ink-900/40 to-transparent"></div>
            <div class="absolute bottom-0 left-0 right-0 p-8 text-white">
              <div class="text-xs uppercase tracking-[0.3em] text-brand-400 mb-2">
                ${p.year} · ${escapeHtml(p.location)}
              </div>
              <h3 class="font-display font-bold text-3xl md:text-4xl">${escapeHtml(p.title)}</h3>
              <p class="mt-3 max-w-xl text-white/80 text-sm md:text-base leading-relaxed">
                ${escapeHtml(p.description)}
              </p>
            </div>
          </div>
        </div>
      `).join('');

      // Re-inicializar Swiper para que reconozca los nuevos slides
      if (typeof (window as any).__initProjectsSwiper === 'function') {
        (window as any).__initProjectsSwiper();
      }
    } catch (err) {
      console.warn('No se pudo cargar proyectos destacados desde Supabase:', err);
    }
  })();
</script>
