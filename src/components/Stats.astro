---
import statsData from '../data/stats.json';
type Stat = { label: string; value: number; suffix?: string };
const items = statsData as Stat[];
---

<section class="bg-ink-900 text-white py-20 -mt-1">
  <div class="container-x grid grid-cols-2 md:grid-cols-4 gap-10">
    {items.map((s, i) => (
      <div class="text-center md:text-left" data-aos="fade-up" data-aos-delay={i * 100}>
        <div
          class="stat font-display font-bold text-5xl md:text-6xl text-brand-400"
          data-target={s.value}
          data-suffix={s.suffix ?? ''}
        >
          0{s.suffix ?? ''}
        </div>
        <div class="mt-3 text-white/70 uppercase tracking-[0.2em] text-xs">
          {s.label}
        </div>
      </div>
    ))}
  </div>
</section>
