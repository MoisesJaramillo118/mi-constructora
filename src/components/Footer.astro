---
import site from '../data/site.json';
import { waLink } from '../lib/utils';
const year = new Date().getFullYear();
---

<footer class="site-footer relative text-white pt-20 pb-10 mt-24">
  <!-- Línea naranja decorativa arriba (separación visual de la sección CTA) -->
  <div class="absolute top-0 left-0 right-0 h-[3px] bg-gradient-to-r from-brand-600 via-brand-500 to-brand-700"></div>

  <div class="container-x grid grid-cols-1 md:grid-cols-4 gap-12 relative">

    <div class="md:col-span-2">
      <div class="flex items-center gap-3 mb-5">
        <span class="inline-flex w-12 h-12 rounded-full bg-brand-600 items-center justify-center
                     text-white font-display font-bold text-base shadow-lg shadow-brand-600/40">
          {site.short_name ?? 'SC'}
        </span>
        <span class="font-display font-bold text-2xl tracking-tight">{site.name}</span>
      </div>
      <p class="text-white/75 max-w-md leading-relaxed">{site.tagline}</p>
    </div>

    <div>
      <h4 class="uppercase tracking-[0.25em] text-xs text-brand-400 font-bold mb-5">Contacto</h4>
      <ul class="space-y-3 text-white/85 text-sm">
        {site.phone && (
          <li><a href={`tel:${site.phone}`} class="hover:text-brand-400 transition">📞 {site.phone}</a></li>
        )}
        {site.email && (
          <li><a href={`mailto:${site.email}`} class="hover:text-brand-400 transition">✉️ {site.email}</a></li>
        )}
        {site.address && <li class="text-white/70">📍 {site.address}</li>}
      </ul>
    </div>

    <div>
      <h4 class="uppercase tracking-[0.25em] text-xs text-brand-400 font-bold mb-5">Redes</h4>
      <ul class="space-y-3 text-white/85 text-sm">
        {site.instagram && (
          <li><a href={site.instagram} target="_blank" rel="noopener" class="hover:text-brand-400 transition">Instagram</a></li>
        )}
        {site.facebook && (
          <li><a href={site.facebook} target="_blank" rel="noopener" class="hover:text-brand-400 transition">Facebook</a></li>
        )}
        {site.whatsapp && (
          <li><a href={waLink(site.whatsapp, 'Hola Santa Cruz, vengo desde la web.')} target="_blank" rel="noopener" class="hover:text-brand-400 transition">WhatsApp</a></li>
        )}
      </ul>
    </div>
  </div>

  <div class="container-x mt-14 pt-6 border-t border-white/15 flex flex-col md:flex-row justify-between items-center gap-3 text-xs text-white/60 relative">
    <span>© {year} {site.name}. Todos los derechos reservados.</span>
    <span>Hecho con cuidado.</span>
  </div>
</footer>

<style>
  .site-footer {
    /* Negro sólido más profundo que la sección anterior (ink-900) — crea contraste */
    background-color: #050810;
    /* Sombra interna superior para reforzar separación */
    box-shadow: inset 0 12px 24px -12px rgba(0, 0, 0, 0.6);
  }
</style>
