---
// Icon.astro — SVGs inline para los servicios.
// Uso: <Icon name="hammer" class="w-7 h-7" />
type Props = {
  name: 'draft' | 'hammer' | 'wrench' | 'beam' | 'shield' | 'doc' | 'bolt' | 'pipe' | 'brush' | 'layers' | 'metal' | string;
  class?: string;
};
const { name, class: className = 'w-7 h-7' } = Astro.props;

const paths: Record<string, string> = {
  draft:  '<path d="M3 3h11l5 5v13H3z"/><path d="M14 3v5h5"/><path d="M8 14h8M8 18h5"/>',
  hammer: '<path d="M14 3l7 7-3 3-7-7zM5 21l7-7 3 3-7 7z"/>',
  wrench: '<path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18l3 3 6.3-6.3a4 4 0 0 0 5.4-5.4l-2.5 2.5-2.2-2.2z"/>',
  beam:   '<path d="M3 7h18M3 17h18M7 7v10M17 7v10M3 7v10M21 7v10"/>',
  shield: '<path d="M12 3l8 4v6c0 4.5-3.5 7.5-8 8-4.5-.5-8-3.5-8-8V7z"/><path d="M9 12l2 2 4-4"/>',
  doc:    '<path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/><path d="M14 3v6h6M8 13h8M8 17h6"/>',
  bolt:   '<path d="M13 2L3 14h9l-1 8 10-12h-9z"/>',
  pipe:   '<path d="M5 12h14M5 12a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2"/><path d="M5 12a2 2 0 0 0-2 2v3a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2"/><circle cx="7" cy="7" r="1" fill="currentColor" stroke="none"/><circle cx="7" cy="17" r="1" fill="currentColor" stroke="none"/>',
  brush:  '<path d="M18 3a3 3 0 0 1 0 6l-9 9a3 3 0 1 1-4-4l9-9a3 3 0 0 1 4-1z"/><path d="M6 18l-2 2"/>',
  layers: '<path d="M12 2L2 7l10 5 10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/>',
  metal:  '<path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><path d="M9 22V12h6v10"/><path d="M9 7h6"/>',
};

const body = paths[name] ?? paths.doc;
---
<svg viewBox="0 0 24 24" class={className}
     fill="none" stroke="currentColor" stroke-width="1.6"
     stroke-linecap="round" stroke-linejoin="round"
     set:html={body} />
