---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import site from '../data/site.json';
import { waLink } from '../lib/utils';

const waUrl = site.whatsapp ? waLink(site.whatsapp, site.whatsapp_message ?? 'Hola, vengo desde la web') : null;
---

<BaseLayout
  title={`Contacto — ${site.name}`}
  description="Solicita una cotización o conversemos sobre tu proyecto."
>
  <section class="relative overflow-hidden bg-ink-900 pb-20 pt-36 text-white md:pb-24 md:pt-44">
    <div class="pointer-events-none absolute -left-36 top-16 h-96 w-96 rounded-full border-[4rem] border-brand-300/[0.08]"></div>
    <div class="pointer-events-none absolute -right-24 -top-10 h-80 w-80 rounded-full border border-brand-300/20"></div>
    <div class="contact-grid pointer-events-none absolute inset-0 opacity-25"></div>

    <div class="container-x relative grid gap-10 lg:grid-cols-[1.02fr_.98fr] lg:items-center lg:gap-14">
      <div data-aos="fade-up">
        <span class="eyebrow text-brand-300">Contacto</span>
        <h1 class="max-w-3xl text-balance font-display text-[2.65rem] font-extrabold leading-[1.02] sm:text-5xl lg:text-6xl">
          Hablemos de tu próxima obra
        </h1>
        <p class="mt-5 max-w-xl text-base leading-relaxed text-white/66 md:text-lg">
          Cuéntanos qué necesitas y te ayudaremos a encontrar el mejor camino para comenzar.
        </p>

        <div class="mt-8 grid max-w-xl gap-3 sm:grid-cols-2">
          {site.phone && (
            <a href={`tel:${site.phone}`} class="rounded-2xl border border-white/14 bg-white/[0.06] p-5 backdrop-blur-sm transition hover:border-brand-300/60 hover:bg-white/[0.1]">
              <span class="text-[10px] font-bold uppercase tracking-[0.22em] text-brand-300">Llámanos</span>
              <strong class="mt-2 block text-base">{site.phone}</strong>
            </a>
          )}
          {waUrl && (
            <a href={waUrl} target="_blank" rel="noopener" class="rounded-2xl border border-white/14 bg-white/[0.06] p-5 backdrop-blur-sm transition hover:border-green-400/60 hover:bg-white/[0.1]">
              <span class="text-[10px] font-bold uppercase tracking-[0.22em] text-green-300">WhatsApp</span>
              <strong class="mt-2 block text-base">Escríbenos al chat</strong>
            </a>
          )}
        </div>
      </div>

      <div class="contact-hero-media" data-aos="fade-left">
        <img
          src="https://institutoelectrotech.edu.pe/wp-content/uploads/2026/04/MAESTRO-DE-OBRAS.jpg"
          alt="Profesional supervisando una obra de construcción"
          class="h-full w-full object-cover"
          loading="eager"
          fetchpriority="high"
        />
        <div class="contact-hero-shade" aria-hidden="true"></div>
        <div class="contact-hero-caption">
          <span class="block text-[10px] font-extrabold uppercase tracking-[0.24em] text-brand-300">Atención personalizada</span>
          <strong class="mt-1 block font-display text-xl leading-tight text-white sm:text-2xl">Tu proyecto empieza con una buena conversación.</strong>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-[#f7f4ed] py-20 md:py-28">
    <div class="container-x grid grid-cols-1 gap-10 lg:grid-cols-5 lg:gap-14">

      <aside class="space-y-6 lg:col-span-2" data-aos="fade-right">
        <div>
          <span class="eyebrow">Canales de atención</span>
          <h2 class="font-display text-3xl font-extrabold text-ink-900">Contáctanos directamente</h2>
          <p class="mt-3 text-ink-700/68">Respondemos en menos de 24h hábiles.</p>
        </div>

        <div class="space-y-3">
          {site.phone && (
            <a href={`tel:${site.phone}`} class="contact-method group">
              <span class="contact-method-icon" aria-hidden="true">01</span>
              <span>
                <span class="block text-[10px] font-extrabold uppercase tracking-[0.2em] text-ink-700/48">Teléfono</span>
                <strong class="mt-1 block text-base text-ink-900 sm:text-lg">{site.phone}</strong>
              </span>
              <span class="ml-auto text-xl text-brand-600 transition group-hover:translate-x-1" aria-hidden="true">→</span>
            </a>
          )}

          {site.email && (
            <a href={`mailto:${site.email}`} class="contact-method group">
              <span class="contact-method-icon" aria-hidden="true">02</span>
              <span class="min-w-0">
                <span class="block text-[10px] font-extrabold uppercase tracking-[0.2em] text-ink-700/48">Correo</span>
                <strong class="mt-1 block break-all text-base text-ink-900">{site.email}</strong>
              </span>
              <span class="ml-auto hidden text-xl text-brand-600 transition group-hover:translate-x-1 sm:block" aria-hidden="true">→</span>
            </a>
          )}

          {waUrl && (
            <a href={waUrl} target="_blank" rel="noopener" class="contact-method group">
              <span class="contact-method-icon" aria-hidden="true">03</span>
              <span>
                <span class="block text-[10px] font-extrabold uppercase tracking-[0.2em] text-ink-700/48">WhatsApp</span>
                <strong class="mt-1 block text-base text-ink-900 sm:text-lg">Escríbenos al chat</strong>
              </span>
              <span class="ml-auto text-xl text-brand-600 transition group-hover:translate-x-1" aria-hidden="true">→</span>
            </a>
          )}
        </div>

        {site.address && (
          <div class="rounded-2xl border border-ink-900/8 bg-white/72 p-5">
            <span class="text-[10px] font-extrabold uppercase tracking-[0.2em] text-ink-700/48">Dirección</span>
            <p class="mt-2 text-sm font-semibold leading-relaxed text-ink-900">{site.address}</p>
          </div>
        )}
      </aside>

      <div class="lg:col-span-3" data-aos="fade-left">
        <ContactForm />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-grid {
    background-image:
      linear-gradient(rgba(255,255,255,.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,.05) 1px, transparent 1px);
    background-size: 52px 52px;
    mask-image: linear-gradient(to right, #000, transparent);
  }
  .contact-hero-media {
    position: relative;
    min-height: 310px;
    overflow: hidden;
    border: 1px solid rgba(228, 189, 92, .3);
    border-radius: 1.5rem;
    background: #0a2742;
    box-shadow: 0 28px 70px rgba(0, 0, 0, .28);
  }
  .contact-hero-media::before {
    content: '';
    position: absolute;
    inset: .75rem;
    z-index: 2;
    border: 1px solid rgba(255, 255, 255, .16);
    border-radius: 1rem;
    pointer-events: none;
  }
  .contact-hero-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(4, 27, 51, .96) 0%, rgba(4, 27, 51, .18) 62%, transparent 100%);
  }
  .contact-hero-caption {
    position: absolute;
    right: 2rem;
    bottom: 1.8rem;
    left: 2rem;
    z-index: 3;
    max-width: 28rem;
  }
  @media (min-width: 1024px) {
    .contact-hero-media {
      min-height: 460px;
    }
  }
  .contact-method {
    display: flex;
    min-height: 76px;
    align-items: center;
    gap: 1rem;
    border: 1px solid rgba(4, 27, 51, .09);
    border-radius: 1rem;
    background: rgba(255,255,255,.78);
    padding: 1rem;
    box-shadow: 0 10px 30px rgba(4,27,51,.035);
    transition: border-color .25s ease, transform .25s ease, box-shadow .25s ease;
  }
  .contact-method:hover {
    transform: translateY(-2px);
    border-color: rgba(213,166,55,.48);
    box-shadow: 0 16px 36px rgba(4,27,51,.08);
  }
  .contact-method-icon {
    display: inline-flex;
    width: 2.75rem;
    height: 2.75rem;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    border-radius: .8rem;
    background: #041b33;
    color: #e4bd5c;
    font-size: .68rem;
    font-weight: 800;
    letter-spacing: .08em;
  }
</style>
