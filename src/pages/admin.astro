---
import BaseLayout from '../layouts/BaseLayout.astro';
import site from '../data/site.json';
---

<BaseLayout
  title={`Panel admin — ${site.name}`}
  description="Panel de administración de proyectos"
>
  <section class="min-h-screen bg-ink-900 text-white pt-32 pb-20">
    <div class="container-x">
      <!-- ─── Login gate ─── -->
      <div id="login-gate" class="max-w-md mx-auto bg-ink-800 rounded-2xl p-8 shadow-xl">
        <h1 class="text-2xl font-bold mb-2">Panel de administración</h1>
        <p class="text-white/60 mb-6">Ingresa la contraseña para acceder.</p>
        <form id="login-form" class="space-y-4">
          <input
            id="password-input"
            type="password"
            placeholder="Contraseña"
            class="w-full px-4 py-3 rounded-lg bg-ink-900 border border-white/10 focus:border-brand-400 focus:outline-none"
            autocomplete="current-password"
          />
          <button
            type="submit"
            class="w-full py-3 bg-brand-400 hover:bg-brand-500 text-ink-900 font-semibold rounded-lg transition"
          >
            Entrar
          </button>
          <p id="login-error" class="text-red-400 text-sm hidden">Contraseña incorrecta.</p>
        </form>
      </div>

      <!-- ─── Panel admin (oculto hasta login OK) ─── -->
      <div id="admin-panel" class="hidden">
        <!-- Encabezado -->
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-8 gap-4">
          <div>
            <h1 class="text-3xl font-bold">Panel de Proyectos</h1>
            <p class="text-white/60 mt-1">Sube, edita y elimina obras del portafolio.</p>
          </div>
          <div class="flex gap-3">
            <button
              id="btn-new"
              class="px-5 py-2.5 bg-brand-400 hover:bg-brand-500 text-ink-900 font-semibold rounded-lg transition"
            >
              + Nuevo proyecto
            </button>
            <button
              id="btn-logout"
              class="px-4 py-2.5 bg-white/10 hover:bg-white/20 text-white rounded-lg transition"
            >
              Cerrar sesión
            </button>
          </div>
        </div>

        <!-- Lista de proyectos -->
        <div id="projects-list" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <!-- Se rellena por JS -->
        </div>

        <!-- Estado vacío -->
        <div id="empty-state" class="hidden text-center py-20 text-white/50">
          No hay proyectos todavía. Pulsa "Nuevo proyecto" para comenzar.
        </div>

        <!-- Mensaje de carga -->
        <div id="loading-state" class="text-center py-20 text-white/50">
          Cargando proyectos...
        </div>
      </div>

      <!-- ─── Modal Form ─── -->
      <div id="modal" class="hidden fixed inset-0 z-50 bg-black/70 backdrop-blur-sm overflow-y-auto">
        <div class="min-h-screen px-4 py-12 flex items-start justify-center">
          <div class="bg-ink-800 rounded-2xl p-8 w-full max-w-2xl shadow-2xl">
            <div class="flex items-center justify-between mb-6">
              <h2 id="modal-title" class="text-2xl font-bold">Nuevo proyecto</h2>
              <button id="btn-close-modal" class="text-white/60 hover:text-white text-2xl leading-none">
                &times;
              </button>
            </div>

            <form id="project-form" class="space-y-5">
              <input type="hidden" id="form-id" />
              <input type="hidden" id="form-current-image" />

              <div>
                <label class="block text-sm font-medium mb-2">Título</label>
                <input
                  id="form-title"
                  type="text"
                  required
                  class="w-full px-4 py-2.5 rounded-lg bg-ink-900 border border-white/10 focus:border-brand-400 focus:outline-none"
                  placeholder="Edificio Las Orquídeas"
                />
              </div>

              <div class="grid grid-cols-2 gap-4">
                <div>
                  <label class="block text-sm font-medium mb-2">Año</label>
                  <input
                    id="form-year"
                    type="number"
                    required
                    min="2000"
                    max="2099"
                    class="w-full px-4 py-2.5 rounded-lg bg-ink-900 border border-white/10 focus:border-brand-400 focus:outline-none"
                  />
                </div>
                <div>
                  <label class="block text-sm font-medium mb-2">Orden</label>
                  <input
                    id="form-order"
                    type="number"
                    value="0"
                    class="w-full px-4 py-2.5 rounded-lg bg-ink-900 border border-white/10 focus:border-brand-400 focus:outline-none"
                  />
                </div>
              </div>

              <div>
                <label class="block text-sm font-medium mb-2">Ubicación</label>
                <input
                  id="form-location"
                  type="text"
                  required
                  class="w-full px-4 py-2.5 rounded-lg bg-ink-900 border border-white/10 focus:border-brand-400 focus:outline-none"
                  placeholder="Miraflores, Lima"
                />
              </div>

              <div>
                <label class="block text-sm font-medium mb-2">Descripción</label>
                <textarea
                  id="form-description"
                  required
                  rows="3"
                  class="w-full px-4 py-2.5 rounded-lg bg-ink-900 border border-white/10 focus:border-brand-400 focus:outline-none"
                  placeholder="Edificio multifamiliar de 8 pisos con áreas comunes premium…"
                ></textarea>
              </div>

              <div>
                <label class="block text-sm font-medium mb-2">Imagen del proyecto</label>
                <div id="image-preview-wrap" class="mb-3 hidden">
                  <img id="image-preview" src="" alt="Preview" class="w-full max-h-48 object-cover rounded-lg" />
                </div>
                <input
                  id="form-image-file"
                  type="file"
                  accept="image/*"
                  class="w-full text-sm text-white/80 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-brand-400 file:text-ink-900 hover:file:bg-brand-500"
                />
                <p class="text-xs text-white/40 mt-2">
                  JPG / PNG / WebP. Tamaño recomendado: 1600×1200 px. Si no eliges una imagen nueva, se mantendrá la actual.
                </p>
              </div>

              <div class="flex items-center gap-2">
                <input
                  id="form-featured"
                  type="checkbox"
                  class="w-4 h-4 rounded"
                />
                <label for="form-featured" class="text-sm">Marcar como destacado</label>
              </div>

              <div class="flex gap-3 pt-4">
                <button
                  type="submit"
                  id="form-submit"
                  class="flex-1 py-3 bg-brand-400 hover:bg-brand-500 text-ink-900 font-semibold rounded-lg transition disabled:opacity-50"
                >
                  Guardar
                </button>
                <button
                  type="button"
                  id="btn-cancel-modal"
                  class="px-6 py-3 bg-white/10 hover:bg-white/20 text-white rounded-lg transition"
                >
                  Cancelar
                </button>
              </div>

              <p id="form-error" class="text-red-400 text-sm hidden"></p>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // ──────────────────────────────────────────────────────────
  // Panel admin completo (auth + CRUD)
  // ──────────────────────────────────────────────────────────
  import {
    getProjects, createProject, updateProject, deleteProject,
    uploadImage, deleteImageByUrl, slugify,
    type Project,
  } from '../lib/supabase';

  const ADMIN_PASSWORD = import.meta.env.PUBLIC_ADMIN_PASSWORD ?? '';
  const STORAGE_KEY = 'sc_admin_auth';

  // ─── Login gate ─────────────────────────────────────────
  const loginGate = document.getElementById('login-gate')!;
  const adminPanel = document.getElementById('admin-panel')!;
  const loginForm = document.getElementById('login-form') as HTMLFormElement;
  const passwordInput = document.getElementById('password-input') as HTMLInputElement;
  const loginError = document.getElementById('login-error')!;

  function isAuthed() {
    return sessionStorage.getItem(STORAGE_KEY) === '1';
  }
  function showPanel() {
    loginGate.classList.add('hidden');
    adminPanel.classList.remove('hidden');
    loadProjects();
  }
  function showLogin() {
    loginGate.classList.remove('hidden');
    adminPanel.classList.add('hidden');
  }

  if (isAuthed()) showPanel();

  loginForm.addEventListener('submit', (e) => {
    e.preventDefault();
    if (passwordInput.value === ADMIN_PASSWORD) {
      sessionStorage.setItem(STORAGE_KEY, '1');
      loginError.classList.add('hidden');
      showPanel();
    } else {
      loginError.classList.remove('hidden');
      passwordInput.value = '';
    }
  });

  document.getElementById('btn-logout')?.addEventListener('click', () => {
    sessionStorage.removeItem(STORAGE_KEY);
    showLogin();
  });

  const listEl = document.getElementById('projects-list')!;
  const emptyEl = document.getElementById('empty-state')!;
  const loadingEl = document.getElementById('loading-state')!;
  const modal = document.getElementById('modal')!;
  const modalTitle = document.getElementById('modal-title')!;
  const form = document.getElementById('project-form') as HTMLFormElement;
  const formId = document.getElementById('form-id') as HTMLInputElement;
  const formCurrentImage = document.getElementById('form-current-image') as HTMLInputElement;
  const formTitle = document.getElementById('form-title') as HTMLInputElement;
  const formYear = document.getElementById('form-year') as HTMLInputElement;
  const formOrder = document.getElementById('form-order') as HTMLInputElement;
  const formLocation = document.getElementById('form-location') as HTMLInputElement;
  const formDescription = document.getElementById('form-description') as HTMLTextAreaElement;
  const formImageFile = document.getElementById('form-image-file') as HTMLInputElement;
  const formFeatured = document.getElementById('form-featured') as HTMLInputElement;
  const formSubmit = document.getElementById('form-submit') as HTMLButtonElement;
  const formError = document.getElementById('form-error')!;
  const imagePreview = document.getElementById('image-preview') as HTMLImageElement;
  const imagePreviewWrap = document.getElementById('image-preview-wrap')!;

  let editingId: string | null = null;

  // ─── Render de la grilla ─────────────────────────────────
  async function loadProjects() {
    loadingEl.classList.remove('hidden');
    emptyEl.classList.add('hidden');
    listEl.innerHTML = '';

    const projects = await getProjects();
    loadingEl.classList.add('hidden');

    if (projects.length === 0) {
      emptyEl.classList.remove('hidden');
      return;
    }

    projects.forEach((p) => {
      const card = document.createElement('div');
      card.className = 'bg-ink-800 rounded-xl overflow-hidden border border-white/5';
      card.innerHTML = `
        <div class="aspect-[4/3] bg-ink-900 overflow-hidden">
          <img src="${p.image}" alt="${escapeHtml(p.title)}" class="w-full h-full object-cover" loading="lazy" />
        </div>
        <div class="p-4">
          <div class="flex items-start justify-between gap-2 mb-2">
            <h3 class="font-semibold text-lg">${escapeHtml(p.title)}</h3>
            ${p.featured ? '<span class="text-xs px-2 py-1 bg-brand-400/20 text-brand-400 rounded-full">★ Destacado</span>' : ''}
          </div>
          <p class="text-sm text-white/60 mb-1">${escapeHtml(p.location)} · ${p.year}</p>
          <p class="text-sm text-white/40 line-clamp-2 mb-4">${escapeHtml(p.description)}</p>
          <div class="flex gap-2">
            <button data-edit="${p.id}" class="flex-1 px-3 py-2 bg-white/10 hover:bg-white/20 text-white text-sm rounded-lg transition">
              Editar
            </button>
            <button data-delete="${p.id}" data-image="${p.image}" class="px-3 py-2 bg-red-500/20 hover:bg-red-500/40 text-red-300 text-sm rounded-lg transition">
              Eliminar
            </button>
          </div>
        </div>
      `;
      listEl.appendChild(card);
    });

    // Listeners
    listEl.querySelectorAll<HTMLButtonElement>('[data-edit]').forEach(btn => {
      btn.addEventListener('click', () => {
        const id = btn.dataset.edit!;
        const proj = projects.find(p => p.id === id)!;
        openEditModal(proj);
      });
    });
    listEl.querySelectorAll<HTMLButtonElement>('[data-delete]').forEach(btn => {
      btn.addEventListener('click', async () => {
        const id = btn.dataset.delete!;
        const image = btn.dataset.image!;
        if (!confirm(`¿Eliminar este proyecto?\n\nEsto borrará también la imagen del storage.`)) return;
        btn.disabled = true;
        await deleteImageByUrl(image);
        const { error } = await deleteProject(id);
        if (error) {
          alert('Error al eliminar: ' + error.message);
          btn.disabled = false;
        } else {
          loadProjects();
        }
      });
    });
  }

  function escapeHtml(s: string): string {
    return s
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  // ─── Modal: abrir nuevo / editar ─────────────────────────
  function openNewModal() {
    editingId = null;
    modalTitle.textContent = 'Nuevo proyecto';
    form.reset();
    formId.value = '';
    formCurrentImage.value = '';
    imagePreviewWrap.classList.add('hidden');
    formError.classList.add('hidden');
    modal.classList.remove('hidden');
  }

  function openEditModal(p: Project) {
    editingId = p.id;
    modalTitle.textContent = 'Editar proyecto';
    formId.value = p.id;
    formTitle.value = p.title;
    formYear.value = String(p.year);
    formOrder.value = String(p.order ?? 0);
    formLocation.value = p.location;
    formDescription.value = p.description;
    formFeatured.checked = !!p.featured;
    formCurrentImage.value = p.image;
    formImageFile.value = '';
    imagePreview.src = p.image;
    imagePreviewWrap.classList.remove('hidden');
    formError.classList.add('hidden');
    modal.classList.remove('hidden');
  }

  function closeModal() {
    modal.classList.add('hidden');
    editingId = null;
  }

  document.getElementById('btn-new')?.addEventListener('click', openNewModal);
  document.getElementById('btn-close-modal')?.addEventListener('click', closeModal);
  document.getElementById('btn-cancel-modal')?.addEventListener('click', closeModal);

  // Preview de imagen al seleccionar archivo
  formImageFile.addEventListener('change', () => {
    const file = formImageFile.files?.[0];
    if (file) {
      imagePreview.src = URL.createObjectURL(file);
      imagePreviewWrap.classList.remove('hidden');
    }
  });

  // ─── Submit del form ─────────────────────────────────────
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    formError.classList.add('hidden');
    formSubmit.disabled = true;
    formSubmit.textContent = 'Guardando…';

    try {
      const title = formTitle.value.trim();
      const file = formImageFile.files?.[0];

      // Determinar imagen final
      let imageUrl = formCurrentImage.value;
      if (file) {
        const uploaded = await uploadImage(file);
        if (!uploaded) throw new Error('No se pudo subir la imagen.');
        // Si estamos editando y había una imagen previa en nuestro bucket, intentamos borrarla
        if (editingId && formCurrentImage.value) {
          await deleteImageByUrl(formCurrentImage.value);
        }
        imageUrl = uploaded;
      }
      if (!imageUrl) throw new Error('Debes subir una imagen.');

      const data: Project = {
        id: editingId ?? slugify(title),
        title,
        year: parseInt(formYear.value),
        location: formLocation.value.trim(),
        image: imageUrl,
        description: formDescription.value.trim(),
        featured: formFeatured.checked,
        order: parseInt(formOrder.value || '0'),
      };

      let result;
      if (editingId) {
        const { id, ...patch } = data;
        result = await updateProject(editingId, patch);
      } else {
        result = await createProject(data);
      }

      if (result.error) throw new Error(result.error.message);

      closeModal();
      loadProjects();
    } catch (err: any) {
      formError.textContent = err.message ?? 'Error desconocido';
      formError.classList.remove('hidden');
    } finally {
      formSubmit.disabled = false;
      formSubmit.textContent = 'Guardar';
    }
  });

  // Cerrar modal al clickear fuera
  modal.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });
</script>
