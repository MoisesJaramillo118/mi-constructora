---
import BaseLayout from '../layouts/BaseLayout.astro';
import site from '../data/site.json';
import projectsData from '../data/projects.json';

type Project = { id: string; title: string; year: number; location: string; image: string;
                 description: string; featured?: boolean; order?: number };

// SSR-fallback: si Supabase está sin configurar o falla, se muestran los del JSON.
// El script de cliente intentará reemplazar la grilla con datos frescos de Supabase.
const fallback: Project[] = (projectsData as Project[])
  .sort((a, b) => (a.order ?? 0) - (b.order ?? 0));
---

<BaseLayout
  title={`Proyectos — ${site.name}`}
  description="Una muestra de las obras que hemos entregado."
>

  <section class="relative pt-44 pb-24 bg-ink-900 text-white overflow-hidden">
    <div class="absolute inset-0 -z-10 opacity-30">
      <img src="https://images.unsplash.com/photo-1503387762-592deb58ef4e?auto=format&fit=crop&w=1920&q=80" alt="" class="w-full h-full object-cover" />
      <div class="absolute inset-0 bg-gradient-to-b from-ink-900 via-ink-900/70 to-ink-900"></div>
    </div>

    <div class="container-x text-center">
      <span class="eyebrow text-brand-400" data-aos="fade-up">Portafolio</span>
      <h1 class="h-section text-balance max-w-3xl mx-auto" data-aos="fade-up" data-aos-delay="100">
        Obras que construyen confianza
      </h1>
      <p class="mt-6 text-white/70 max-w-2xl mx-auto text-lg" data-aos="fade-up" data-aos-delay="200">
        Cada proyecto es un compromiso cumplido. Aquí algunos de los más representativos.
      </p>
    </div>
  </section>

  <section class="py-24">
    <div id="projects-grid" class="container-x grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {fallback.map((p, i) => (
        <article
          class="group relative rounded-2xl overflow-hidden shadow-md hover:shadow-2xl transition-all duration-500 bg-ink-900"
          data-aos="fade-up"
          data-aos-delay={(i % 3) * 100}
        >
          <div class="aspect-[4/3] overflow-hidden">
            <img src={p.image} alt={p.title} loading="lazy"
                 class="w-full h-full object-cover transition duration-700 group-hover:scale-110" />
          </div>

          <div class="absolute inset-0 bg-gradient-to-t from-ink-900 via-ink-900/30 to-transparent opacity-90 group-hover:opacity-95 transition"></div>

          <div class="absolute bottom-0 left-0 right-0 p-6 text-white translate-y-2 group-hover:translate-y-0 transition duration-500">
            <div class="text-[11px] uppercase tracking-[0.3em] text-brand-400 mb-2">
              {p.year} · {p.location}
            </div>
            <h2 class="font-display font-bold text-2xl leading-tight">{p.title}</h2>
            <p class="mt-3 text-white/80 text-sm leading-relaxed opacity-0 max-h-0 group-hover:opacity-100 group-hover:max-h-40 transition-all duration-500 overflow-hidden">
              {p.description}
            </p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <script>
    // Hidrata la grilla con datos frescos de Supabase (admin puede actualizar al vuelo).
    // Si falla la conexión, el SSR ya renderizó los fallback del JSON.
    import { getProjects } from '../lib/supabase';

    function escapeAttr(s: string): string {
      return s.replace(/&/g, '&amp;').replace(/"/g, '&quot;');
    }
    function escapeHtml(s: string): string {
      return s
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    (async () => {
      try {
        const projects = await getProjects();
        if (!projects.length) return; // mantener fallback

        const grid = document.getElementById('projects-grid');
        if (!grid) return;
        grid.innerHTML = projects.map((p, i) => `
          <article class="group relative rounded-2xl overflow-hidden shadow-md hover:shadow-2xl transition-all duration-500 bg-ink-900" data-aos="fade-up" data-aos-delay="${(i % 3) * 100}">
            <div class="aspect-[4/3] overflow-hidden">
              <img src="${escapeAttr(p.image)}" alt="${escapeAttr(p.title)}" loading="lazy" class="w-full h-full object-cover transition duration-700 group-hover:scale-110" />
            </div>
            <div class="absolute inset-0 bg-gradient-to-t from-ink-900 via-ink-900/30 to-transparent opacity-90 group-hover:opacity-95 transition"></div>
            <div class="absolute bottom-0 left-0 right-0 p-6 text-white translate-y-2 group-hover:translate-y-0 transition duration-500">
              <div class="text-[11px] uppercase tracking-[0.3em] text-brand-400 mb-2">
                ${p.year} · ${escapeHtml(p.location)}
              </div>
              <h2 class="font-display font-bold text-2xl leading-tight">${escapeHtml(p.title)}</h2>
              <p class="mt-3 text-white/80 text-sm leading-relaxed opacity-0 max-h-0 group-hover:opacity-100 group-hover:max-h-40 transition-all duration-500 overflow-hidden">
                ${escapeHtml(p.description)}
              </p>
            </div>
          </article>
        `).join('');
      } catch (err) {
        console.warn('No se pudo cargar projects desde Supabase, usando fallback:', err);
      }
    })();
  </script>

  <section class="bg-slate-50 py-20">
    <div class="container-x text-center" data-aos="fade-up">
      <h2 class="h-section text-ink-900 max-w-2xl mx-auto">¿Listo para sumar tu proyecto a la lista?</h2>
      <a href="/contacto" class="btn-primary mt-8">Contáctanos</a>
    </div>
  </section>

</BaseLayout>
