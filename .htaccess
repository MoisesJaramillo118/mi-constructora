# Apache config — sirve para Hosting Perú, InfinityFree y la mayoría de shared hosting.

# ─── Errores personalizados ──────────────────────────────────────────
ErrorDocument 404 /404.php

# ─── URLs limpias: /contacto → /contacto.php ─────────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Bloquear acceso directo a carpetas internas
  RewriteRule ^data/      - [F,L]
  RewriteRule ^includes/  - [F,L]
  RewriteRule ^vendor/    - [F,L]

  # Si la URL ya termina en .php, dejar pasar
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Probar agregando .php
  RewriteCond %{REQUEST_FILENAME}.php -f
  RewriteRule ^(.+)$ $1.php [L]
</IfModule>

# ─── Bloquear acceso a archivos sensibles ────────────────────────────
<FilesMatch "\.(json|md|log)$">
  Require all denied
</FilesMatch>

# Permitir solo manifest.json y similares en raíz (descomenta si los usas)
# <Files "manifest.json">
#   Require all granted
# </Files>

# ─── Cache + compresión ──────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css            "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType image/jpeg          "access plus 60 days"
  ExpiresByType image/png           "access plus 60 days"
  ExpiresByType image/webp          "access plus 60 days"
  ExpiresByType image/svg+xml       "access plus 60 days"
  ExpiresByType font/woff2          "access plus 365 days"
</IfModule>

# ─── Cabeceras de seguridad ──────────────────────────────────────────
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy        "strict-origin-when-cross-origin"
  Header set X-Frame-Options        "SAMEORIGIN"
</IfModule>
